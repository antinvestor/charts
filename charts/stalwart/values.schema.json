{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "service", "persistence"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },

    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["IfNotPresent", "Always", "Never"] }
      }
    },

    "service": {
      "type": "object",
      "required": ["type", "ports"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "ports": {
          "type": "object",
          "properties": {
            "http": { "type": "integer" },
            "https": { "type": "integer" },
            "smtp": { "type": "integer" },
            "submission": { "type": "integer" },
            "smtps": { "type": "integer" },
            "imap": { "type": "integer" },
            "imaps": { "type": "integer" },
            "sieve": { "type": "integer" }
          }
        }
      }
    },

    "persistence": {
      "type": "object",
      "required": ["enabled", "accessMode", "size", "mountPath"],
      "properties": {
        "enabled": { "type": "boolean" },
        "storageClass": { "type": "string" },
        "accessMode": { "type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany"] },
        "size": { "type": "string" },
        "mountPath": { "type": "string" }
      }
    }
  }
}
