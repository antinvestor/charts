# Git
.git
.gitignore

# Documentation
README.md
LICENSE

# Helm
.helmignore
charts/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp
