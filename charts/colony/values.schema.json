{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Colony Helm Chart Values",
  "description": "Schema for validating Colony Helm chart values",
  "type": "object",
  "required": ["image"],
  "properties": {
    "namespace": {
      "type": "string",
      "description": "Kubernetes namespace for deployment"
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": {
          "type": "string",
          "description": "Image repository",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "description": "Image tag",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create a ServiceAccount"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string",
          "description": "ServiceAccount name (defaults to release name)"
        },
        "imagePullSecrets": {
          "type": "array"
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of replicas"
    },
    "strategy": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["RollingUpdate", "Recreate"]
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Grace period for pod termination"
    },
    "podAnnotations": {
      "type": "object",
      "description": "Annotations for pods"
    },
    "securityContext": {
      "type": "object",
      "description": "Container security context"
    },
    "resources": {
      "type": "object",
      "description": "CPU and memory resources"
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "grpc": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "targetPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "http": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "targetPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "livenessProbe": {
      "type": "object",
      "description": "Liveness probe configuration"
    },
    "readinessProbe": {
      "type": "object",
      "description": "Readiness probe configuration"
    },
    "startupProbe": {
      "type": "object",
      "description": "Startup probe configuration"
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "podAntiAffinity": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": ["preferred", "required"]
        }
      }
    },
    "affinity": {
      "type": "object",
      "description": "Custom affinity rules"
    },
    "logging": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"]
        },
        "format": {
          "type": "string",
          "enum": ["text", "json"]
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["enforced", "disabled"]
        }
      }
    },
    "oauth2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serviceUri": {
          "type": "string",
          "format": "uri"
        },
        "adminUri": {
          "type": "string"
        },
        "tokenEndpointAuthMethod": {
          "type": "string",
          "description": "Token endpoint authentication method (client_secret_basic, client_secret_post, private_key_jwt)",
          "enum": ["", "client_secret_basic", "client_secret_post", "private_key_jwt"]
        },
        "clientId": {
          "type": "string"
        },
        "clientIdRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          },
          "required": ["key"]
        },
        "clientSecretRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          },
          "required": ["key"]
        },
        "workloadAPI": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "trustDomain": {
              "type": "string"
            },
            "socketPath": {
              "type": "string"
            },
            "socketMountPath": {
              "type": "string"
            },
            "csiDriver": {
              "type": "string"
            }
          }
        },
        "privateJWT": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "source": {
              "type": "string",
              "description": "Signer source: url (JWKS URL) or workload_api (SPIFFE)",
              "enum": ["url", "workload_api"]
            },
            "signerUrl": {
              "type": "string",
              "description": "JWKS URL for fetching signing keys (e.g. Hydra admin /admin/keys/{set})"
            },
            "keyId": {
              "type": "string"
            },
            "signerApiKeyRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {"type": "string"},
                "key": {"type": "string"}
              }
            },
            "spiffeID": {
              "type": "string"
            },
            "hint": {
              "type": "string"
            }
          }
        },
        "audienceBaseURL": {
          "type": "string",
          "pattern": "^(|https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(/[A-Za-z0-9._~-]+)*)$"
        },
        "resourcePath": {
          "type": "string",
          "pattern": "^(|/[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*)$"
        },
        "requestedAudiencePaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*$"
          }
        },
        "clientAssertionAudience": {
          "type": "string",
          "pattern": "^(|https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(/[A-Za-z0-9._~-]+)+)$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"enabled": {"const": true}},
            "required": ["enabled"]
          },
          "then": {
            "required": ["audienceBaseURL", "resourcePath", "clientAssertionAudience"],
            "properties": {
              "audienceBaseURL": {
                "pattern": "^https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(/[A-Za-z0-9._~-]+)*$"
              },
              "resourcePath": {
                "pattern": "^/[A-Za-z0-9._~-]+(/[A-Za-z0-9._~-]+)*$"
              },
              "clientAssertionAudience": {
                "pattern": "^https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(/[A-Za-z0-9._~-]+)+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tokenEndpointAuthMethod": {"const": "private_key_jwt"}
            },
            "required": ["tokenEndpointAuthMethod"]
          },
          "then": {
            "required": ["privateJWT"],
            "properties": {
              "privateJWT": {
                "properties": {"enabled": {"const": true}},
                "required": ["enabled"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "privateJWT": {
                "properties": {"enabled": {"const": true}},
                "required": ["enabled"]
              }
            },
            "required": ["privateJWT"]
          },
          "then": {
            "properties": {
              "tokenEndpointAuthMethod": {"const": "private_key_jwt"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "privateJWT": {
                "properties": {
                  "enabled": {"const": true},
                  "source": {"const": "url"}
                },
                "required": ["enabled", "source"]
              }
            },
            "required": ["privateJWT"]
          },
          "then": {
            "properties": {
              "privateJWT": {
                "properties": {"signerUrl": {"minLength": 1}},
                "required": ["signerUrl"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "privateJWT": {
                "properties": {
                  "enabled": {"const": true},
                  "source": {"const": "workload_api"}
                },
                "required": ["enabled", "source"]
              }
            },
            "required": ["privateJWT"]
          },
          "then": {
            "properties": {
              "workloadAPI": {
                "properties": {
                  "enabled": {"const": true},
                  "trustDomain": {"minLength": 1}
                },
                "required": ["enabled", "trustDomain"]
              }
            }
          }
        }
      ]
    },
    "opentelemetry": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "environment": {
          "type": "string"
        },
        "protocol": {
          "type": "string",
          "enum": ["grpc", "http"]
        },
        "endpoint": {
          "type": "string"
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": ["http", "grpc"]
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "httpRoute": {
          "type": "object",
          "properties": {
            "spec": {
              "type": "object",
              "description": "Full HTTPRoute spec override (replaces parentRefs/hostnames/rules)"
            },
            "hostnames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rules": {
              "type": "array",
              "description": "Custom HTTPRoute rules array (replaces default rule)"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": ["hostnames"],
                "properties": {
                  "hostnames": {
                    "minItems": 1
                  }
                }
              },
              {
                "properties": {
                  "httpRoute": {
                    "required": ["spec"]
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "externalDNS": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "fluxcd": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "envFrom": {
      "type": "array",
      "description": "Environment variables from ConfigMaps and Secrets"
    },
    "env": {
      "type": "array",
      "description": "Additional environment variables"
    },
    "volumes": {
      "type": "array",
      "description": "Additional volumes"
    },
    "volumeMounts": {
      "type": "array",
      "description": "Additional volume mounts"
    },
    "labels": {
      "type": "object",
      "description": "Additional labels"
    },
    "annotations": {
      "type": "object",
      "description": "Additional annotations"
    }
  }
}
